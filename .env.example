# Copy file này thành .env rồi điền chuỗi kết nối PostgreSQL.
# File .env KHÔNG được đưa lên GitHub (đã có trong .gitignore).

# Neon (miễn phí): lấy ở trang Neon → Dashboard → Connect → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Hoặc PostgreSQL chạy trên máy:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nhahang3d

# Cổng chạy server (Render tự đặt biến này, không cần điền)
# PORT=5173
