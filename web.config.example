<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình để IIS (MonsterASP.NET) chạy server Node của game.
  1. Copy file này thành  web.config  (KHÔNG đưa web.config lên GitHub — đã có trong .gitignore)
  2. Điền thông tin database lấy từ Control Panel > Databases > Connection string
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments=".\serve.js" startupTimeLimit="60"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Thông tin SQL Server (thay bằng của bạn) -->
        <environmentVariable name="DB_SERVER" value="dbXXXX.databaseasp.net" />
        <environmentVariable name="DB_NAME" value="dbXXXX" />
        <environmentVariable name="DB_USER" value="dbXXXX" />
        <environmentVariable name="DB_PASSWORD" value="MAT_KHAU_DATABASE" />
        <environmentVariable name="DB_TRUST_CERT" value="true" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
